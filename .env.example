# Copy to .env and fill in. Never commit the filled-in .env.

# Microsoft Foundry project endpoint. Drives synthetic generation, cloud evaluation, and
# inference - the notebook derives its OpenAI client from this single value.
# Format: https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_PROJECT_ENDPOINT=

# Deployment name of the model under test. Any provider works (OpenAI, DeepSeek, Llama, Grok, ...) -
# Foundry serves them all on the same route, and content filtering is configured per deployment.
# Also used to generate the synthetic corpus.
FOUNDRY_MODEL_NAME=

# Optional: a second deployment to compare against the same test corpus.
FOUNDRY_MODEL_NAME_B=

# Optional: reusable dataset name. Defaults to content-safety-boundary-corpus.
FOUNDRY_DATASET_NAME=

# Label describing the content filter currently attached to the deployment, e.g. highest-blocking.
# A deployment carries one filter at a time, so this is recorded per run rather than detected.
# Every exported file is suffixed with it, and section 9 compares runs by this label.
# Defaults to "unlabelled", which makes cross-policy comparison meaningless.
FOUNDRY_GUARDRAIL_POLICY=

# Authentication is keyless through DefaultAzureCredential - run `az login` and make sure the
# signed-in identity holds the Foundry User role. The notebook reads no API key.
